# --- agent ---------------------------------------------------------------
BACKEND=mongo                      # mongo | supabase | immich
DEVICE_ID=frame-kitchen            # defaults to hostname
DEVICE_TOKEN=dev-token-frame-kitchen
MEDIA_ROOT=/home/pi/Pictures/frames
STATE_DIR=/home/pi/.frame-sync
POLL_SECONDS=300                   # fallback full-sync if push is silent
HEARTBEAT_SECONDS=60
# Set once you've worked out the right URL from Dynaframe's web UI; {playlist} is substituted.
# DYNAFRAME_RELOAD_URL=http://127.0.0.1:8000/?COMMAND=RELOAD
LOG_LEVEL=INFO

# --- mongo track ---------------------------------------------------------
MONGO_URI=mongodb+srv://frame:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=framesync
OWNER_ID=andrew
FRAME_WIDTH=1920

# object storage: EITHER a public base url (dev) OR S3-compatible presigning (R2/B2/MinIO)
STORAGE_BASE_URL=https://pub-xxxxxxxx.r2.dev
# S3_BUCKET=frame-sync
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto

# --- supabase track ------------------------------------------------------
# BACKEND=supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co     # local: http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJ...                           # public key; RLS is the real guard
DEVICE_EMAIL=frame-kitchen@frames.local
DEVICE_PASSWORD=frame-kitchen-pass
